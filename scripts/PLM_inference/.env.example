# Private inputs, checkpoints, predictions, and reports live below this directory.
MENTAL_LLM_DATA_ROOT=/path/to/private/runtime_data

# Optional cache and access token for encoder downloads.
HF_HOME=/path/to/private/huggingface/cache
HF_TOKEN=replace_only_if_model_access_requires_authentication

# Optional default configuration.
MENTAL_LLM_CONFIG=/path/to/mental_llm_github_v2/configs/portable/binary.json

